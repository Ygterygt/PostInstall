# ==============================================================================
# Antigravity Computer Maintenance Pro - .gitignore
# ==============================================================================

# Installer binaries (GitHub 100MB limit & distribution binaries)
Installers/*
!Installers/.gitkeep
!Installers/README.md

# Offline driver packages (machine specific)
Drivers/

# Machine-specific snapshots (registry / environment exports may contain secrets)
Backups/

# Runtime State & Cache (runtime data now lives in %ProgramData%\ComputerMaintenancePro)
State/
*.tmp

# Local logs
*.log

# Test outputs (regenerated on every run)
TestResults.json

# Release packages (Tools\New-ReleasePackage.ps1)
dist/
