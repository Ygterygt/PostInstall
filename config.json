{
  "ApplicationName": "Computer Maintenance Pro - Enterprise System Care & Staging Suite",
  "TargetHost": "*",
  "Version": "4.0.0",
  "LogFile": "C:\\Windows\\Temp\\PostInstall.log",
  "ErrorLogFile": "C:\\Windows\\Temp\\PostInstall_Error.log",
  "StateFile": "C:\\Windows\\Temp\\PostInstall_State.json",
  "SummaryReport": "C:\\Windows\\Temp\\PostInstall_Summary.md",
  "DocsSyncPath": "%USERPROFILE%\\Desktop\\Antigravity\\Docs",
  "AutoReboot": true,
  "RebootCountdownSeconds": 20,
  "RunOnceKeyName": "ComputerMaintenanceProResume",
  "MaxRetriesPerStep": 2,
  "Theme": "DarkEnterprise",
  "Maintenance": {
    "TempCleanDaysThreshold": 0,
    "PruneEventLogMaxSizeBytes": 20971520,
    "DismResetBase": true,
    "ReTrimVolumes": true,
    "AutoFlushDns": true
  }
}
