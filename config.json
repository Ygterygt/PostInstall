{
  "ApplicationName": "Computer Maintenance Pro - Enterprise System Care & Staging Suite",
  "TargetHost": "*",
  "Version": "4.2.0",
  "LogFile": "%ProgramData%\\ComputerMaintenancePro\\Logs\\PostInstall.log",
  "ErrorLogFile": "%ProgramData%\\ComputerMaintenancePro\\Logs\\PostInstall_Error.log",
  "StateFile": "%ProgramData%\\ComputerMaintenancePro\\State\\PostInstall_State.json",
  "SummaryReport": "%ProgramData%\\ComputerMaintenancePro\\Reports\\PostInstall_Summary.md",
  "DocsSyncPath": "",
  "AutoReboot": true,
  "RebootCountdownSeconds": 20,
  "RunOnceKeyName": "ComputerMaintenanceProResume",
  "MaxRetriesPerStep": 1,
  "StepTimeoutSeconds": 1800,
  "Theme": "DarkEnterprise",
  "Maintenance": {
    "TempCleanDaysThreshold": 1,
    "EmptyRecycleBin": false,
    "PruneEventLogs": true,
    "PruneEventLogMaxSizeBytes": 20971520,
    "DismResetBase": false,
    "ReTrimVolumes": true,
    "AutoFlushDns": true
  },
  "Network": {
    "ChangeDns": true,
    "DnsServers": ["1.1.1.1", "1.0.0.1"],
    "SkipIfDomainJoined": true
  },
  "Updates": {
    "ExcludeIds": []
  }
}
